{
  "name": "skibidiwriter-backend",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "concurrently --names drizzle,app -c cyan,green \"nodemon --watch src/models -e ts --exec bun db:push\" \"bun run --hot src/index.ts\"",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "@hono/bun": "^1.0.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.11",
    "pg": "^8.23.0",
    "zod": "^4.6.5",
    "skibidiwriter-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15"
  }
}